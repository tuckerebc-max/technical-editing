{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/te/run-manifest.schema.json",
  "title":"MWM TE Run Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["run_id","manuscript_file","manuscript_version","project_profile","style_registry_version","stage","output_format","asset_manifest","exception_register","prior_run_id","parser_version","ownership_map","surfaces","fields_expected"],
  "properties":{
    "run_id":{"type":"string","pattern":"^MWM-TE-[A-Za-z0-9._-]+$"},
    "manuscript_file":{"type":"string","minLength":1},
    "manuscript_version":{"type":"string","minLength":1},
    "manuscript_sha256":{"type":["string","null"],"pattern":"^[A-Fa-f0-9]{64}$"},
    "project_profile":{"type":"string","minLength":1},
    "style_registry_version":{"type":"string","minLength":1},
    "stage":{"type":"string","enum":["intake","technical_edit","production_handoff","proof_dependency"]},
    "output_format":{"type":"string","enum":["docx","pdf","jats","typeset_package"]},
    "asset_manifest":{"type":"string","minLength":1},
    "exception_register":{"type":"string","minLength":1},
    "prior_run_id":{"type":["string","null"]},
    "parser_version":{"type":"string","minLength":1},
    "ownership_map":{"type":"string","minLength":1},
    "surfaces":{"type":"array","minItems":1,"items":{"type":"string","enum":["headings","tables","figures","captions","notes","equations","cross_references","links","acronyms","quantitative_notation","appendices","assets","accessibility","permissions"]}},
    "fields_expected":{"type":"boolean"},
    "template_version":{"type":["string","null"]},
    "proof_package_id":{"type":["string","null"]}
  }
}
