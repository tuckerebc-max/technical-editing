{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/te/decision-record.schema.json",
  "title":"MWM TE Human Decision Record",
  "type":"object",
  "additionalProperties":false,
  "required":["decision_id","object_id","question","evidence","owner","options","consequences","requested_decision","status","decision","decided_by","decided_at"],
  "properties":{
    "decision_id":{"type":"string","pattern":"^TE-DEC-[A-Za-z0-9._-]+$"},
    "object_id":{"type":"string"},
    "question":{"type":"string","minLength":1},
    "evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["type","locator"],"properties":{"type":{"type":"string"},"locator":{"type":"string"},"description":{"type":"string"}}}},
    "owner":{"type":"string","minLength":1},
    "options":{"type":"array","minItems":1,"items":{"type":"string"}},
    "consequences":{"type":"array","items":{"type":"string"}},
    "requested_decision":{"type":"string","minLength":1},
    "status":{"type":"string","enum":["open","decided","deferred","rejected"]},
    "decision":{"type":["string","null"]},
    "decided_by":{"type":["string","null"]},
    "decided_at":{"type":["string","null"]},
    "decision_hook_id":{"type":["string","null"],"pattern":"^TE-DH-[0-9]{3}$"}
  }
}
