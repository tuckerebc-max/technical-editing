{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/te/finding.schema.json",
  "title":"MWM TE Technical Finding",
  "type":"object",
  "additionalProperties":false,
  "required":["finding_id","skill_id","object_id","owner_category","rule_id","rule_version","severity","status","action","confidence","location","observed","expected","evidence","dependencies","reason","owner","decision_log_id"],
  "properties":{
    "finding_id":{"type":"string","pattern":"^TE-[A-Za-z0-9._-]+$"},
    "skill_id":{"type":"string","pattern":"^TE-0[1-8]$"},
    "object_id":{"type":"string"},
    "owner_category":{"type":"string","enum":["style","technical","design","accessibility","rights","production","proof","citation","substantive"]},
    "rule_id":{"type":"string","pattern":"^TE-[A-Z0-9-]+$"},
    "rule_version":{"type":"string"},
    "severity":{"type":"string","enum":["critical","high","medium","low","informational"]},
    "status":{"type":"string","enum":["verified","needs_review","blocked","permitted","not_checked"]},
    "action":{"type":"string","enum":["AUTO_FIX","SUGGEST","FLAG","ESCALATE","BLOCK","CLOSE"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "location":{"type":"object","additionalProperties":false,"required":["file","locator","context_type"],"properties":{"file":{"type":"string"},"locator":{"type":"string"},"context_type":{"type":"string","enum":["body","heading","table","figure","caption","note","appendix","asset","proof"]}}},
    "observed":{"type":"object","additionalProperties":false,"required":["raw_text","structural_state"],"properties":{"raw_text":{"type":["string","null"]},"structural_state":{"type":"string"},"original_value":{"type":["string","null"]}}},
    "expected":{"type":"object","additionalProperties":false,"required":["value"],"properties":{"value":{"type":"string"},"rule_scope":{"type":["string","null"]}}},
    "evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["source_id","locator","method"],"properties":{"source_id":{"type":"string"},"locator":{"type":"string"},"method":{"type":"string"},"relevance":{"type":"string"}}}},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "proposed_change":{"type":["string","null"]},
    "reason":{"type":"string","minLength":1},
    "owner":{"type":"string","minLength":1},
    "decision_log_id":{"type":["string","null"]},
    "disposition":{"type":["string","null"]}
  }
}
