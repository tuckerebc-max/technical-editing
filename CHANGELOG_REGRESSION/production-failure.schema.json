{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/te/production-failure.schema.json",
  "title":"MWM TE Production Failure Capture",
  "type":"object",
  "additionalProperties":false,
  "required":["failure_id","detected_at","chapter_or_asset","run_id","stage","failure_class","impact","containment","evidence","release_effect","owner","follow_up"],
  "properties":{
    "failure_id":{"type":"string","pattern":"^TE-PF-[A-Za-z0-9._-]+$"},
    "detected_at":{"type":"string","minLength":1},
    "chapter_or_asset":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "stage":{"type":"string","enum":["intake","technical_edit","production_handoff","proof_dependency","released"]},
    "failure_class":{"type":"string","enum":["wrong_identity","incomplete_object","partial_coverage","broken_target","field_failure","stale_dependency","acronym_scope_leak","notation_meaning_change","rights_inference","accessibility_claim","asset_metadata_gap","handoff_ownership_failure","report_unreproducible","release_gate_failure"]},
    "impact":{"type":"string","enum":["contained","chapter_local","multi_chapter","release_blocking","publicly_released"]},
    "containment":{"type":"string","minLength":1},
    "evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["type","locator"],"properties":{"type":{"type":"string"},"locator":{"type":"string"},"description":{"type":"string"}}}},
    "release_effect":{"type":"string","enum":["none","hold","rollback","post_release_correction","decision_required"]},
    "owner":{"type":"string","minLength":1},
    "related_regression_ids":{"type":"array","items":{"type":"string","pattern":"^TE-REG-[A-Za-z0-9._-]+$"}},
    "affected_rule_ids":{"type":"array","items":{"type":"string","pattern":"^TE-[A-Z0-9-]+$"}},
    "affected_object_ids":{"type":"array","items":{"type":"string"}},
    "follow_up":{"type":"string","minLength":1},
    "closed_at":{"type":["string","null"]}
  }
}
